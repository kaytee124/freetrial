PORT=3000
NODE_ENV=development
BASE_URL=http://localhost:3000
SWAGGER_ENABLED=true

# Run pending Sequelize migrations when server starts (default: true except NODE_ENV=test)
RUN_MIGRATIONS_ON_START=true

DB_HOST=localhost
DB_PORT=3306
DB_NAME=laundry_management_system
DB_NAME_TEST=laundry_management_system_test
DB_NAME_BENCHMARK=laundry_management_system_benchmark
DB_USER=root
DB_PASSWORD=

JWT_SECRET=change-me-in-production
JWT_ACCESS_EXPIRES=60m
JWT_REFRESH_EXPIRES=1d

CSRF_COOKIE_NAME=csrf_token
REFRESH_COOKIE_NAME=refresh_token

# Default passwords for NEW staff-created users are derived as Kolendo@{username}
# (see utils/passwords.js). Existing users are unchanged. DEFAULT_CUSTOMER_PASSWORD is no longer used.

# Customer web app (used in welcome SMS)
CUSTOMER_APP_URL=https://laundry.bafrow-health.org

# Moolre payments (see README)
MOOLRE_API_USER=
MOOLRE_API_PUBKEY=
MOOLRE_ACCOUNT_NUMBER=
MOOLRE_WEBHOOK_URL=
MOOLRE_WEBHOOK_SECRET=
MOOLRE_WEBHOOK_RATE_LIMIT_MAX=60
MOOLRE_WEBHOOK_RATE_LIMIT_WINDOW_MS=60000

# Welcome magic-link login (staff-created customers)
WELCOME_LOGIN_RATE_LIMIT_MAX=20
WELCOME_LOGIN_RATE_LIMIT_WINDOW_MS=900000
# Portal/welcome magic-link TTL in hours (default 30 days)
WELCOME_LOGIN_TOKEN_TTL_HOURS=720
MOOLRE_REDIRECT_URL=
MOOLRE_API_BASE=https://api.moolre.com
MOOLRE_MERCHANT_EMAIL=Kolendolaundry@gmail.com
MOOLRE_PATH_EMBED_LINK=/embed/link
MOOLRE_PATH_TRANSACT_STATUS=/open/transact/status
MOOLRE_PATH_TRANSACT_PAYMENT=/open/transact/payment
MOOLRE_PATH_SMS_SEND=/open/sms/send

# Moolre SMS (notifications use SENDER_ID; payment receipts use SENDER_ID_2)
MOOLRE_SMS_VAS_KEY=
MOOLRE_SMS_SENDER_ID=
MOOLRE_SMS_SENDER_ID_2=
